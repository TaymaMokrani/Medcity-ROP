VITE_API_URL=http://localhost:4000/api

# --- docker-compose.yml: the database and pgAdmin ---
# Generate a password with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# backend/nest/.env DATABASE_URL must use the same user, password and name.
POSTGRES_USER=medcity
POSTGRES_PASSWORD=
POSTGRES_DB=medcity
PGADMIN_PASSWORD=

# --- docker-compose.yml: MinIO object storage (photographs, evidence) ---
# The password must be at least 8 characters. backend/nest/.env STORAGE_*
# must use the same user and password.
MINIO_ROOT_USER=medcity
MINIO_ROOT_PASSWORD=
