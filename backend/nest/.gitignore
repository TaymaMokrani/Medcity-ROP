# dotenv environment variable files — never commit real values,
# only the .env.example template that documents which keys are needed
.env
.env.*
!.env.example

# uploaded retinal images — patient data, must never enter git history
/uploads

# embedded PGlite database files — patient data, same rule
/data

# temp directory
.temp
.tmp

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
