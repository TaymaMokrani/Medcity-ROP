JWT_SECRET=
JWT_EXPIRES_IN=7d
#   postgres://user:password@localhost:5432/medcity   the Postgres server from
#                     docker-compose.yml (the default). Same user, password and
#                     name as POSTGRES_* in the root .env.
#   pglite://./data   embedded Postgres persisted to ./data — quick tests only
#   pglite            embedded Postgres in memory — wiped on every restart
DATABASE_URL=postgres://medcity:CHANGE_ME@localhost:5432/medcity
# Object storage for photographs and evidence (S3 API). Locally: the MinIO
# container from docker-compose.yml, with MINIO_ROOT_* from the root .env.
# In production: any S3-compatible store (Amazon S3, a hospital's MinIO…).
STORAGE_ENDPOINT=http://127.0.0.1:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=medcity
STORAGE_ACCESS_KEY=medcity
STORAGE_SECRET_KEY=CHANGE_ME
PORT=4000
CORS_ORIGINS=http://localhost:3000
# Base URL of the FastAPI ML service (see backend/fastapi/README.md).
ML_SERVICE_URL=http://127.0.0.1:8000
ML_SERVICE_AUTOSTART=true

# The interpreter that has the ML service's dependencies (torch, timm, opencv).
# `python` is only right if your default interpreter has them.
ML_SERVICE_PYTHON=python

# Where the service lives. Defaults to ../fastapi, which is correct in this repo.
# ML_SERVICE_DIR=

# --- Phase 2: severity service (see backend/fastapi-phase2/README.md) ---

# Base URL of the severity service. Unset means severity analysis is simply not
# offered; it is never faked.
SEVERITY_SERVICE_URL=http://127.0.0.1:8100

# Start it with the gateway, same rule as the Phase 1 service: local URLs only.
# The gateway does not wait for it — two segmentation models and LoFTR take the
# best part of a minute to load, and the rest of the app should not be blocked.
SEVERITY_SERVICE_AUTOSTART=true

# The interpreter that has torch, kornia and opencv. This is NOT the same
# environment as the Phase 1 service, and the default `python` on PATH is a
# different install that fails silently.
SEVERITY_SERVICE_PYTHON=C:\Users\LENOVO\anaconda3\envs\vessel_v2\python.exe

# Where the service lives. Defaults to ../fastapi-phase2, correct in this repo.
# SEVERITY_SERVICE_DIR=

# The Vessel Workspace measures a single photograph when that is all the doctor
# has. The service's own default is 2 (stitching needs two); the detection flow
# always sends 5, so lowering it only affects the Workspace. Passed through to the
# service when the gateway starts it.
PHASE2_MIN_IMAGES=1
ML_SERVICE_PYTHON=python # Leave as is
